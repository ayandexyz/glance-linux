#!/usr/bin/env bash
# Stand-in for glancectl in the QML harness. GLANCE_FAKE_MODE picks the
# behaviour: online (default), offline, garbage, crash.
set -euo pipefail
mode=${GLANCE_FAKE_MODE:-online}
cmd=${1:-}
case $mode in
  crash) echo "boom" >&2; exit 3 ;;
  garbage) echo "<html>"; exit 0 ;;
esac
case $cmd in
  status)
    if [[ $mode == offline ]]; then
      echo '{"schemaVersion": 1, "reachable": false, "error": "daemon not reachable", "armed": false, "scanning": false, "enrolled": true, "models": {"landmarker": true, "arcface": true}, "identities": [], "lastScan": null}'
      exit 1
    fi
    echo '{"schemaVersion": 1, "reachable": true, "armed": true, "mode": "light", "scanning": false, "enrolled": true, "remembered": false, "camera": "/dev/video0", "models": {"landmarker": true, "arcface": true}, "pam": {"module": true, "hyprlock": false, "shellPassword": true, "shellFingerprint": false, "wired": true}, "identities": [{"name": "tester", "enabled": true, "captures": 5}], "lastScan": {"outcome": "unlocked", "identity": "tester", "similarity": 0.7, "reason": null, "at": 1700000000, "duration": 1.2}}'
    ;;
  authenticate)
    echo '{"outcome": "unlocked", "identity": "tester", "similarity": 0.7, "reason": null}'
    ;;
  arm)
    read -r passphrase
    if [[ $passphrase == "correct" ]]; then
      echo '{"schemaVersion": 1, "armed": true}'
    else
      echo "wrong passphrase" >&2
      exit 1
    fi
    ;;
  disarm)
    echo '{"schemaVersion": 1, "armed": false}'
    ;;
  *) echo "unknown subcommand: $cmd" >&2; exit 2 ;;
esac
