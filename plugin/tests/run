#!/usr/bin/env bash
set -euo pipefail

plugin_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
shell_root=${OMARCHY_PATH:-/usr/share/omarchy}/shell
# Not /tmp: the backend refuses a glancectl under a world-writable directory,
# which is the point, so the fakes live somewhere only this user can write.
private_tmp=${XDG_RUNTIME_DIR:-$HOME/.cache}
mkdir -p "$private_tmp"
test_root=$(mktemp -d -p "$private_tmp" glance-plugin-test.XXXXXX)
trap 'rm -rf -- "$test_root"' EXIT

echo "== GlanceLogic unit tests =="
node "$plugin_root/tests/test_glance_logic.js"

echo
echo "== manifest contract =="
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$plugin_root"
  echo "omarchy plugin validate: passed"
else
  echo "omarchy not installed; skipped"
fi

echo
echo "== qmllint =="
# Advisory: the qmllint shipped on some Omarchy installs exits non-zero without
# printing anything, so only actual messages are treated as findings.
if command -v qmllint >/dev/null 2>&1 && [[ -d $shell_root ]]; then
  lint_output=$(qmllint -I "$shell_root" "$plugin_root/Panel.qml" "$plugin_root/StatusBackend.qml" 2>&1 || true)
  if [[ -n $lint_output ]]; then
    echo "$lint_output"
    if grep -qi "error" <<<"$lint_output"; then exit 1; fi
  fi
  echo "qmllint: no findings"
else
  echo "qmllint or the Omarchy shell not available; skipped"
fi

echo
echo "== QML integration =="
if ! command -v quickshell >/dev/null 2>&1; then
  echo "quickshell not installed; skipped"; exit 0
fi
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  echo "no Wayland session; skipped"; exit 0
fi

# Quickshell maps the `qs` module prefix onto the config root, so the plugin is
# mirrored next to symlinks of the shell's own Ui and Commons modules.
run_root="$test_root/run"
mkdir -p "$run_root"
ln -s "$shell_root/Ui" "$run_root/Ui"
ln -s "$shell_root/Commons" "$run_root/Commons"
cp "$plugin_root"/*.qml "$plugin_root"/*.js "$run_root/"
cp "$plugin_root/tests/qml/shell.qml" "$run_root/shell.qml"

make_wrapper() {
  cat >"$test_root/$1" <<WRAPPER
#!/usr/bin/env bash
export GLANCE_FAKE_MODE=$2
exec "$plugin_root/tests/fake-glancectl" "\$@"
WRAPPER
  chmod +x "$test_root/$1"
}
make_wrapper fake-online online
make_wrapper fake-offline offline
make_wrapper fake-garbage garbage
make_wrapper fake-crash crash
make_wrapper fake-fresh fresh
make_wrapper fake-flood flood
make_wrapper fake-hang hang
# Byte-identical to fake-online, so the only thing that changes when it is
# renamed over it mid-run is the inode.
cp "$test_root/fake-online" "$test_root/fake-swap"
# The same fake under a world-writable directory: must be refused unrun.
mkdir -m 777 "$test_root/open"
cp "$test_root/fake-online" "$test_root/open/glancectl"

export GLANCE_TEST_RESULT="$test_root/result.json"
export GLANCE_PANEL_URL="file://$run_root/Panel.qml"
export GLANCE_BACKEND_URL="file://$run_root/StatusBackend.qml"
export GLANCE_FAKE_ONLINE="$test_root/fake-online"
export GLANCE_FAKE_OFFLINE="$test_root/fake-offline"
export GLANCE_FAKE_GARBAGE="$test_root/fake-garbage"
export GLANCE_FAKE_CRASH="$test_root/fake-crash"
export GLANCE_FAKE_FRESH="$test_root/fake-fresh"
export GLANCE_FAKE_FLOOD="$test_root/fake-flood"
export GLANCE_FAKE_OPEN="$test_root/open/glancectl"
export GLANCE_FAKE_HANG="$test_root/fake-hang"
export GLANCE_FAKE_SWAP="$test_root/fake-swap"
export GLANCE_FAKE_DESCENDANT="$test_root/descendant"
export GLANCE_FAKE_MARKER="$test_root/enroll-argv"
export GLANCE_FAKE_ENV_MARKER="$test_root/env"
# Canaries: the plugin must not pass these through to what it runs.
export PYTHONPATH=/nonexistent/canary
export PATH="$test_root/shadow:$PATH"

log="$test_root/quickshell.log"
if ! timeout 90 quickshell --path "$run_root/shell.qml" >"$log" 2>&1; then
  echo "quickshell exited non-zero" >&2; sed -n '1,80p' "$log" >&2; exit 1
fi
if [[ ! -f $GLANCE_TEST_RESULT ]]; then
  echo "harness wrote no result" >&2; sed -n '1,80p' "$log" >&2; exit 1
fi
python3 - "$GLANCE_TEST_RESULT" <<'PY'
import json, sys
report = json.load(open(sys.argv[1]))
for failure in report["failures"]:
    print(f"  FAIL: {failure}")
if not report["ok"]:
    sys.exit(1)
print("QML integration: all assertions passed")
PY

# The hanging fake left a grandchild in the process group timeout(1) created.
# If the deadline had reached only the process the plugin spawned, the
# grandchild would still be asleep; it recorded the signal it actually got.
if [[ ! -f "$GLANCE_FAKE_DESCENDANT.pid" ]]; then
  echo "  FAIL: the hanging fake never started a descendant" >&2; exit 1
fi
descendant=$(<"$GLANCE_FAKE_DESCENDANT.pid")
if kill -0 "$descendant" 2>/dev/null; then
  echo "  FAIL: descendant $descendant survived the deadline" >&2; exit 1
fi
if [[ ! -f $GLANCE_FAKE_DESCENDANT ]] || [[ $(<"$GLANCE_FAKE_DESCENDANT") != terminated ]]; then
  echo "  FAIL: descendant $descendant was never signalled; the deadline reached one process, not the tree" >&2
  exit 1
fi
echo "Deadline: the descendant died with the group, not just the child"

# The swap phase renamed a different inode over the checked path. It only
# works if the file is re-checked before every command, so if it ran, it ran.
if [[ -f $GLANCE_FAKE_SWAP ]]; then
  echo "  FAIL: the harness never swapped the fake glancectl" >&2; exit 1
fi
echo "Identity: a file swapped behind the path was caught before the next command"

# The harness clicked Enroll for real. What the fake recorded is the argv that
# survived GlanceLogic's wrapping, Quickshell's Process, and setsid --fork.
if [[ ! -f $GLANCE_FAKE_MARKER ]]; then
  echo "  FAIL: Enroll launched nothing; no argv recorded" >&2; exit 1
fi
expected="enroll --name $(id -un) --gui --remember"
actual=$(<"$GLANCE_FAKE_MARKER")
if [[ $actual != "$expected" ]]; then
  echo "  FAIL: Enroll ran the wrong command" >&2
  echo "    expected: $expected" >&2
  echo "    actual:   $actual" >&2
  exit 1
fi
echo "Enroll launch: reached glancectl as '$actual'"

# The environment the fake saw: PATH pinned, PYTHONPATH gone.
if [[ ! -f $GLANCE_FAKE_ENV_MARKER ]]; then
  echo "  FAIL: no environment recorded" >&2; exit 1
fi
if ! grep -qx 'PATH=/usr/bin:/usr/share/omarchy/bin' "$GLANCE_FAKE_ENV_MARKER" \
   || ! grep -qx 'PYTHONPATH=unset' "$GLANCE_FAKE_ENV_MARKER" \
   || ! grep -qx 'LD_PRELOAD=unset' "$GLANCE_FAKE_ENV_MARKER"; then
  echo "  FAIL: child environment not controlled:" >&2; cat "$GLANCE_FAKE_ENV_MARKER" >&2; exit 1
fi
echo "Child environment: PATH pinned, PYTHONPATH and LD_PRELOAD dropped"

echo
echo "all tests passed"
