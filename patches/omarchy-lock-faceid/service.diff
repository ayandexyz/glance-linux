+  // Long enough to read the check mark, short enough that the session does
+  // not feel withheld: the afterglow carries the rest of the confirmation on
+  // the far side of the unlock, where it costs the user nothing.
+  Timer {
+    id: faceUnlockTimer
+    interval: 550
+    repeat: false
+    onTriggered: {
